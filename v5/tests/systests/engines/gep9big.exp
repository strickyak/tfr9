#!/usr/bin/expect -f
# gep9big.exp -- Hatvan OS on TFR/911H with EMBIGGEN 2-level MMU (gep9big, boot mode 81).
set timeout 30
set send_slow {1 0.03}
source [file join [file dirname [file normalize [info script]]] common.exp]
puts "Engine gep9big"
start_tether 81
expect_pass "tfr911h/hatvan/gep9big matches the plan" "IoMap matched tfr911h/hatvan/gep9big"
expect_pass "EMBIGGEN IO and MMU initialized" "EMBIGGEN 2-level MMU initialized"
expect_pass "Hatvan OS" "Hatvan OS kernel banner printed"
expect_pass "SHELL:FORK:OK" "Hatvan OS forked initial shell"
expect_pass "$ " "Reached Hatvan '$ ' prompt"

send -s "echo HELLO_HATVAN_GEP9BIG\r"
expect "echo HELLO_HATVAN_GEP9BIG"
expect_pass "HELLO_HATVAN_GEP9BIG" "'echo' printed HELLO_HATVAN_GEP9BIG"
expect "$ "

send -s "dir\r"
expect_pass "Cmds9" "'dir' listed Cmds9 via RBF Task 1"
expect "$ "

send -s "cat /proc/p\r"
expect_pass "hatvan-kernel" "'cat /proc/p' listed hatvan-kernel via PROCFS Task 2"
expect "$ "

send -s "exit\r"
expect_pass "target shutdown OK (0)" "'exit' shut Hatvan down cleanly with status 0"
# the board reboots after the target stops
after 3000
finish "Engine gep9big"
