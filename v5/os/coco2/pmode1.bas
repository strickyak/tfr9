10 REM 4-COLOR SPIKY STAR DEMO (PMODE 1: 128X96X4)
20 PCLEAR 4:PMODE 1,1:PCLS 3:SCREEN 1,0
30 X=44:Y=83:A=0:D=168:DA=9*6.2831853/20:C=1
40 FOR I=1 TO 20
50 COLOR C,3:NX=X+D*COS(A):NY=Y+D*SIN(A)
60 LINE(X,Y)-(NX,NY),PSET
70 X=NX:Y=NY:A=A+DA
80 IF C=1 THEN C=2 ELSE IF C=2 THEN C=4 ELSE C=1
90 NEXT I
100 IF INKEY$="" THEN 100
110 SCREEN 0
