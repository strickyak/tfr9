10 REM COCO 3 HI-RES 640X192 DEMO (HSCREEN 4: 640X192X4)
20 HSCREEN 4
30 PALETTE 0,0:PALETTE 1,27:PALETTE 2,54:PALETTE 3,45
40 HCLS 0:HCOLOR 2:HLINE(0,0)-(639,191),PSET,B
50 CX=320:CY=96:RX=296:RY=82:N=28:A=0:DA=11*6.2831853/N
60 X=CX+RX:Y=CY:C=1
70 FOR I=1 TO N
80 A=A+DA:NX=CX+RX*COS(A):NY=CY+RY*SIN(A)
90 HCOLOR C:HLINE(X,Y)-(NX,NY),PSET
100 X=NX:Y=NY:C=C+1:IF C>3 THEN C=1
110 NEXT I
120 HCOLOR 2:HCIRCLE(CX,CY),44:HCOLOR 1:HCIRCLE(CX,CY),23
130 IF INKEY$="" THEN 130
140 PALETTE CMP:HSCREEN 0
