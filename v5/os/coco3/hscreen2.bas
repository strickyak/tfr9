10 REM COCO 3 HI-RES 16-COLOR DEMO (HSCREEN 2: 320X192X16)
20 HSCREEN 2
30 FOR I=0 TO 15:READ C:PALETTE I,C:NEXT I
40 DATA 0,37,38,52,54,50,18,26,27,25,11,41,45,44,59,63
50 HCLS 0:HCOLOR 15:HLINE(0,11)-(319,191),PSET,B
60 FOR I=1 TO 15:X=(I-1)*21+3
70 HCOLOR I:HLINE(X,1)-(X+18,8),PSET,BF
80 NEXT I
90 CX=160:CY=101:RX=142:RY=78:N=30:A=0:DA=13*6.2831853/N
100 X=CX+RX:Y=CY:C=1
110 FOR I=1 TO N
120 A=A+DA:NX=CX+RX*COS(A):NY=CY+RY*SIN(A)
130 HCOLOR C:HLINE(X,Y)-(NX,NY),PSET
140 X=NX:Y=NY:C=C+1:IF C>14 THEN C=1
150 NEXT I
160 HCOLOR 15:HCIRCLE(CX,CY),28:HCOLOR 8:HCIRCLE(CX,CY),15
170 IF INKEY$="" THEN 170
180 PALETTE CMP:HSCREEN 0
