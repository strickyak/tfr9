10 REM ========================================
20 REM  TETHER COCO 3 ALL-MODES GRAPHICS TOUR
30 REM  LOOPS IN ~60 SECONDS ACROSS 6 SHOWCASES
40 REM ========================================
50 REM
100 REM --- SCENE 1: SEMIGRAPHICS 4 (64X32 8-COLOR) ---
110 HSCREEN 0: SCREEN 0, 0: WIDTH 32: CLS
120 PRINT @0, "MODE: SEMIGRAPHICS 4 (64X32)"
130 PRINT @32, "8 COLORS: COTTAGE, SUN & TREE"
140 FOR X = 0 TO 63: FOR Y = 26 TO 31: SET(X, Y, 0): NEXT Y, X
150 FOR X = 12 TO 23: FOR Y = 21 TO 25: SET(X, Y, 1): NEXT Y, X
160 FOR I = 0 TO 5: FOR X = 11 + I TO 24 - I: SET(X, 20 - I, 3): NEXT X, I
170 FOR X = 16 TO 19: FOR Y = 23 TO 25: SET(X, Y, 5): NEXT Y, X
180 FOR X = 48 TO 50: FOR Y = 18 TO 26: SET(X, Y, 7): NEXT Y, X
190 FOR X = 42 TO 56: FOR Y = 11 TO 17: SET(X, Y, 0): NEXT Y, X
200 FOR X = 54 TO 60: FOR Y = 3 TO 7: SET(X, Y, 1): NEXT Y, X
210 SET(30, 5, 4): SET(31, 6, 4): SET(32, 5, 4)
220 SET(38, 7, 4): SET(39, 8, 4): SET(40, 7, 4)
230 FOR T = 1 TO 1200: NEXT T
240 REM
300 REM --- SCENE 2: PMODE 1 (128X96 4-COLOR) ---
310 PMODE 1, 1: SCREEN 1, 0: PCLS 2
320 COLOR 0: LINE (0, 70)-(127, 95), PSET, BF
330 COLOR 1: LINE (25, 45)-(75, 75), PSET, BF
340 COLOR 3: LINE (20, 45)-(50, 20), PSET: LINE -(80, 45), PSET: PAINT (50, 30), 3, 3
350 COLOR 2: LINE (45, 58)-(55, 75), PSET, BF
360 COLOR 2: LINE (30, 50)-(40, 60), PSET, BF: LINE (60, 50)-(70, 60), PSET, BF
370 COLOR 3: LINE (65, 20)-(72, 33), PSET, BF
380 COLOR 2: CIRCLE (74, 15), 3: CIRCLE (80, 9), 5: CIRCLE (90, 5), 7
390 COLOR 3: LINE (98, 55)-(104, 75), PSET, BF
400 COLOR 0: CIRCLE (101, 42), 16: PAINT (101, 42), 0, 0
410 COLOR 1: CIRCLE (18, 18), 10: PAINT (18, 18), 1, 1
420 FOR T = 1 TO 1200: NEXT T
430 REM
500 REM --- SCENE 3: PMODE 4 (256X192 2-COLOR HI-RES) ---
510 PMODE 4, 1: SCREEN 1, 1: PCLS 0
520 LINE (0, 120)-(50, 45), PSET: LINE -(105, 95), PSET: LINE -(170, 30), PSET: LINE -(225, 85), PSET: LINE -(255, 60), PSET
530 LINE (50, 45)-(45, 68), PSET: LINE (50, 45)-(58, 70), PSET
540 LINE (170, 30)-(162, 58), PSET: LINE (170, 30)-(180, 62), PSET
550 LINE (0, 150)-(75, 90), PSET: LINE -(140, 140), PSET: LINE -(210, 80), PSET: LINE -(255, 125), PSET
560 CIRCLE (220, 30), 16
570 FOR I = 0 TO 3: X = 40 + I * 25: Y = 25 + I * 10: LINE (X - 7, Y - 4)-(X, Y), PSET: LINE -(X + 7, Y - 4), PSET: NEXT I
580 LINE (0, 185)-(255, 185), PSET
590 LINE (30, 155)-(30, 185), PSET: LINE (80, 160)-(80, 188), PSET: LINE (230, 150)-(230, 185), PSET
600 FOR J = 0 TO 4: Y = 145 + J * 6: LINE (30 - J * 3, Y)-(30 + J * 3, Y), PSET: NEXT J
610 FOR J = 0 TO 5: Y = 150 + J * 6: LINE (80 - J * 4, Y)-(80 + J * 4, Y), PSET: NEXT J
620 FOR J = 0 TO 5: Y = 140 + J * 4: LINE (230 - J * 4, Y)-(230 + J * 4, Y), PSET: NEXT J
630 FOR T = 1 TO 1200: NEXT T
640 REM
700 REM --- SCENE 4: HSCREEN 2 (320X192 16-COLOR SPACE) ---
710 HSCREEN 2: HCLS 8
720 HPRINT (1, 1), "HSCREEN 2: 320X192 16-COLOR SPACE"
730 FOR I = 1 TO 35: X = ((I * 73 + 17) AND 255) + (I AND 31) + 2: Y = ((I * 47 + 23) AND 127) + 12: HSET(X, Y, 4): NEXT I
740 FOR I = 1 TO 15: X = ((I * 91 + 5) AND 255) + 20: Y = ((I * 37 + 11) AND 127) + 15: HSET(X, Y, 1): NEXT I
750 HCOLOR 1, 8: HCIRCLE (225, 80), 26: HPAINT (225, 80), 1, 1
760 HCOLOR 7: HCIRCLE (225, 80), 42, 7, 0.32
770 HCOLOR 4: HCIRCLE (225, 80), 46, 4, 0.32
780 HCOLOR 5: HCIRCLE (225, 80), 50, 5, 0.32
790 HCOLOR 6: HCIRCLE (225, 80), 54, 6, 0.32
800 HCOLOR 3, 8: HCIRCLE (50, 45), 10: HPAINT (50, 45), 3, 3
810 HCOLOR 5, 8: HCIRCLE (295, 30), 6: HPAINT (295, 30), 5, 5
820 HCOLOR 4, 8: HLINE (60, 150)-(110, 115), PSET: HLINE -(110, 125), PSET: HLINE -(60, 150), PSET: HPAINT (95, 125), 4, 4
830 HCOLOR 3, 8: HLINE (110, 115)-(125, 105), PSET: HLINE -(110, 125), PSET: HPAINT (115, 115), 3, 3
840 HCOLOR 2, 8: HLINE (75, 140)-(60, 162), PSET: HLINE -(85, 133), PSET: HPAINT (73, 145), 2, 2
850 HCOLOR 5, 8: HCIRCLE (100, 120), 4: HPAINT (100, 120), 5, 5
860 HCOLOR 7: HLINE (60, 147)-(40, 160), PSET: HLINE -(60, 153), PSET: HPAINT (52, 153), 7, 7
870 HCOLOR 1: HLINE (60, 149)-(48, 157), PSET: HLINE -(60, 151), PSET: HPAINT (55, 152), 1, 1
880 FOR T = 1 TO 1200: NEXT T
890 REM
900 REM --- SCENE 5: HSCREEN 2 (320X192 16-COLOR RAINBOW) ---
910 HSCREEN 2: HCLS 8
920 HPRINT (1, 1), "HSCREEN 2: 320X192 16-COLOR RAINBOW"
930 C = 1: FOR R = 60 TO 100 STEP 6: HCOLOR C: HCIRCLE (160, 191), R: C = C + 1: IF C > 7 THEN C = 1
935 NEXT R
940 HCOLOR 2, 8: HCIRCLE (45, 50), 16: HPAINT (45, 50), 2, 2
945 HCOLOR 2: HLINE (45, 26)-(45, 18), PSET: HLINE (45, 74)-(45, 82), PSET: HLINE (21, 50)-(13, 50), PSET: HLINE (69, 50)-(77, 50), PSET
950 HCOLOR 7, 8: HCIRCLE (230, 52), 13: HPAINT (230, 52), 7, 7: HCIRCLE (255, 52), 13: HPAINT (255, 52), 7, 7: HCIRCLE (242, 42), 15: HPAINT (242, 42), 7, 7
960 HCOLOR 4: FOR X = 0 TO 319 STEP 4: HLINE (X, 191)-(X + 2, 180 + ((X / 4) AND 3) * 3), PSET: NEXT X
970 FOR T = 1 TO 1200: NEXT T
980 REM
1000 REM --- SCENE 6: GIME TEXT (WIDTH 40 & WIDTH 80) ---
1010 SCREEN 0: WIDTH 40: CLS
1020 PRINT "****************************************"
1030 PRINT "*     TETHER COCO 3 GRAPHICS TOUR      *"
1040 PRINT "****************************************"
1050 PRINT ""
1060 PRINT "DEMONSTRATED MODES:"
1070 PRINT " 1. SEMIGRAPHICS 4  (64X32,  8 COLORS)"
1080 PRINT " 2. PMODE 1         (128X96, 4 COLORS)"
1090 PRINT " 3. PMODE 4         (256X192, 2 COLORS)"
1100 PRINT " 4. HSCREEN 2       (320X192 SPACE)"
1110 PRINT " 5. HSCREEN 2       (320X192 RAINBOW)"
1120 PRINT " 6. GIME TEXT       (WIDTH 40 / 80)"
1130 PRINT ""
1140 PRINT "LOOPING DEMO IN 3 SECONDS..."
1150 FOR T = 1 TO 800: NEXT T
1160 WIDTH 80: CLS
1170 PRINT "=== GIME 80-COLUMN HIGH-RESOLUTION TEXT MODE ==="
1180 PRINT "All modes running live on Centipede-32z & Tether Web Display!"
1190 FOR T = 1 TO 500: NEXT T
1200 GOTO 100
