10 DIM P(15),L$(13):FOR I=0 TO 15:P(I)=PEEK(&HFFB0+I)AND63:NEXT
20 DATA 0,63,36,18,9,54,27,45,38,12,24,11,31,7,56,32
30 FOR I=0 TO 15:READ C:PALETTE I,C:NEXT
40 FOR M=1 TO 4
50 X=320:IF M>2 THEN X=640
60 N=4:W=60:IF M=2 THEN N=16:W=20
70 IF M=3 THEN N=2:W=120
80 HSCREEN M:HCOLOR 1,0:HCLS
100 FOR C=0 TO N-1:HCOLOR C,0:HLINE(C*W,24)-(C*W+W-1,63),PSET,BF:NEXT C
105 HCOLOR 1,0:HLINE(0,24)-(N*W-1,63),PSET,B
110 HPRINT(0,0),"HSCREEN"+STR$(M)+","+STR$(N)+" COLORS"
120 HLINE(0,80)-(X-1,191),PSET
130 GOSUB 500
140 NEXT M
200 HSCREEN 2:PALETTE 0,0:PALETTE 1,63:HCOLOR 1,0:HCLS
210 HPRINT(0,0),"PALETTE CODES"
220 FOR B=0 TO 13:R=INT(B/7):Q=B-R*7
230 PALETTE B+2,0:HCOLOR B+2,0:HLINE(Q*45,24+R*48)-(Q*45+40,54+R*48),PSET,BF
240 NEXT B
250 FOR G=0 TO 4:FOR B=0 TO 13:R=INT(B/7):Q=B-R*7
260 K=G*14+B:IF K>63 THEN K$="   ":PALETTE B+2,0:GOTO 280
270 K$=RIGHT$("  "+STR$(K),3):PALETTE B+2,K
280 HCOLOR 0,0:HPRINT(INT(Q*45/8),2+R*6),L$(B):HCOLOR 1,0:HPRINT(INT(Q*45/8),2+R*6),K$:L$(B)=K$
290 NEXT B:GOSUB 500:NEXT G
400 HSCREEN 0:FOR I=0 TO 15:PALETTE I,P(I):NEXT
410 WIDTH 32:PRINT"ALL DONE."
420 END
500 IF INKEY$="" THEN 500
510 RETURN
