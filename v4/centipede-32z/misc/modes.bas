10 FOR M=0 TO 4:FOR S=0 TO 1
20 CLS:PRINT"NEXT: PMODE";M:PRINT"      SCREEN 1,";S
30 PRINT:PRINT"PRESS A KEY TO SHOW IT."
40 PRINT"PRESS A KEY AGAIN FOR THE NEXT."
50 IF INKEY$="" THEN 50
60 PMODE M,1:PCLS:SCREEN 1,S
70 FOR C=1 TO 4:COLOR C+4*S,0
80 X=20+(C-1)*56:LINE(X,30)-(X+44,100),PSET,BF
90 NEXT C
100 COLOR 3+4*S,0
110 LINE(0,110)-(255,191),PSET
120 FOR I=0 TO M:LINE(I*12,0)-(I*12+8,8),PSET,BF:NEXT I
130 IF S=1 THEN LINE(0,14)-(68,18),PSET,BF
140 IF INKEY$="" THEN 140
150 NEXT S,M
160 CLS:PRINT"ALL DONE."
